{
  "name": "@mirid-dev/sendkit-core",
  "version": "0.0.2",
  "description": "Core Telegram messaging operations and zod schemas for SendKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ky-Ling/sendkit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "pack:dry": "bun run build && bun pm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
