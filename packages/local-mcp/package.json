{
  "name": "@mirid-dev/sendkit-local-mcp",
  "version": "0.0.2",
  "description": "Local stdio MCP server that lets AI clients send Telegram messages via SendKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ky-Ling/sendkit.git",
    "directory": "packages/local-mcp"
  },
  "bin": {
