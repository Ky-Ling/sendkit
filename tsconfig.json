{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "customConditions": ["source"],
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node", "bun"],
    "skipLibCheck": true
  }
}
