{
  "name": "sendkit-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:cli": "bun --conditions=source packages/cli/src/index.ts",
    "dev:local-mcp": "bun --conditions=source packages/local-mcp/src/index.ts",
    "dev:remote-mcp": "bun --conditions=source apps/remote-mcp/src/index.ts",
    "build": "bun run --filter './packages/*' build",
    "build:cli": "bun run --filter @mirid-dev/sendkit build",
    "build:core": "bun run --filter @mirid-dev/sendkit-core build",
    "build:mcp-tools": "bun run --filter @mirid-dev/sendkit-mcp-tools build",
    "build:local-mcp": "bun run --filter @mirid-dev/sendkit-local-mcp build",
    "release:pack:core": "bun run --filter @mirid-dev/sendkit-core pack:dry",
    "release:pack:mcp-tools": "bun run --filter @mirid-dev/sendkit-mcp-tools pack:dry",
    "release:pack:cli": "bun run --filter @mirid-dev/sendkit pack:dry",
    "release:pack:local-mcp": "bun run --filter @mirid-dev/sendkit-local-mcp pack:dry",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "test": "bun test --conditions=source",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  }
}
