<mxfile host="drawio"><diagram id="02 OAuth connect flow" name="02 OAuth connect flow"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1690" pageHeight="1630" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Connecting the connector: OAuth discovery and sign-in" style="text;html=1;whiteSpace=wrap;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="770" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Solid arrow = request, dashed = response. Red = the step that failed before the scopes fix." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="680" height="26" as="geometry"/></mxCell><mxCell id="you" value="You (browser)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="1480" as="geometry"/></mxCell><mxCell id="claude" value="claude.ai" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="220" height="1480" as="geometry"/></mxCell><mxCell id="mcp" value="remote-mcp&#xa;(via ngrok)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="220" height="1480" as="geometry"/></mxCell><mxCell id="clerk" value="Clerk" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fontSize=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="220" height="1480" as="geometry"/></mxCell><mxCell id="e3" value="1. Add + Connect" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.0743;entryX=0.5;entryY=0.0743;" edge="1" parent="1" source="you" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="2. POST /mcp (no token)" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.1149;entryX=0.5;entryY=0.1149;" edge="1" parent="1" source="claude" target="mcp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="3. 401 + metadata URL" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.1554;entryX=0.5;entryY=0.1554;" edge="1" parent="1" source="mcp" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="4. GET resource metadata" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.1959;entryX=0.5;entryY=0.1959;" edge="1" parent="1" source="claude" target="mcp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="5. Clerk URL + scopes" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.2365;entryX=0.5;entryY=0.2365;" edge="1" parent="1" source="mcp" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="6. GET AS metadata" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.277;entryX=0.5;entryY=0.277;" edge="1" parent="1" source="claude" target="clerk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="7. endpoints + CIMD" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.3176;entryX=0.5;entryY=0.3176;" edge="1" parent="1" source="clerk" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="8. open authorize URL" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.3581;entryX=0.5;entryY=0.3581;" edge="1" parent="1" source="claude" target="you"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="9. GET /oauth/authorize" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.3986;entryX=0.5;entryY=0.3986;" edge="1" parent="1" source="you" target="clerk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="10. GET CIMD document" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.4392;entryX=0.5;entryY=0.4392;" edge="1" parent="1" source="clerk" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="11. redirect_uris" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.4797;entryX=0.5;entryY=0.4797;" edge="1" parent="1" source="claude" target="clerk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="12. check scopes" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;strokeWidth=2;exitX=0.5;exitY=0.5203;entryX=0.5;entryY=0.5432;" edge="1" parent="1" source="clerk" target="clerk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="880"/><mxPoint x="1100" y="914"/></Array><mxPoint x="71" y="24" as="offset"/></mxGeometry></mxCell><mxCell id="v15" value="Where it broke: step 5 had no scopes_supported, so&#xa;Claude asked for openid + metadata scopes. Clerk&#xa;allows only profile, email, offline_access, so it&#xa;returned invalid_scope and no sign-in page appeared." style="shape=note;html=1;whiteSpace=wrap;size=14;fontSize=13;align=left;spacingLeft=10;spacingRight=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="940" width="400" height="90" as="geometry"/></mxCell><mxCell id="e16" value="13. sign-in + consent" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.6554;entryX=0.5;entryY=0.6554;" edge="1" parent="1" source="clerk" target="you"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="14. approve" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.6959;entryX=0.5;entryY=0.6959;" edge="1" parent="1" source="you" target="clerk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="15. 302 to callback" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.7365;entryX=0.5;entryY=0.7365;" edge="1" parent="1" source="clerk" target="you"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="16. GET auth_callback" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.777;entryX=0.5;entryY=0.777;" edge="1" parent="1" source="you" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="17. POST /oauth/token" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.8176;entryX=0.5;entryY=0.8176;" edge="1" parent="1" source="claude" target="clerk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="18. access token (JWT)" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=open;dashed=1;strokeColor=#666666;fontColor=#4d4d4d;exitX=0.5;exitY=0.8581;entryX=0.5;entryY=0.8581;" edge="1" parent="1" source="clerk" target="claude"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="19. POST + Bearer" style="html=1;fontSize=13;labelBackgroundColor=#ffffff;verticalAlign=bottom;curved=0;rounded=0;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#1a1a1a;exitX=0.5;exitY=0.8986;entryX=0.5;entryY=0.8986;" edge="1" parent="1" source="claude" target="mcp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v23" value="Step 19 continues in 03-authenticated-tool-call." style="shape=note;html=1;whiteSpace=wrap;size=14;fontSize=13;align=left;spacingLeft=10;spacingRight=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="770" y="1480" width="370" height="40" as="geometry"/></mxCell><mxCell id="v24" value="What each step does" style="swimlane;html=1;whiteSpace=wrap;startSize=40;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="430" height="750" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;1.&lt;/b&gt; In claude.ai Settings &amp;gt; Connectors you add the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;server URL, choose &quot;Use Claude's published&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;identity&quot;, then click Connect.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; claude.ai probes the MCP endpoint (initialize) with&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;no Authorization header.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Auth gate: no Bearer header, so 401 with WWW-&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Authenticate: resource_metadata=&quot;...&quot; and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;scope=&quot;profile email&quot;.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; claude.ai follows resource_metadata to /.well-&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;known/oauth-protected-resource/:botToken/mcp.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Our server answers: authorization_servers = Clerk,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;scopes_supported = profile, email.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; claude.ai reads Clerk's /.well-known/oauth-&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;authorization-server.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Clerk lists its endpoints and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;client_id_metadata_document_supported: true, so&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Claude can use CIMD.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; claude.ai opens the authorize URL in your browser.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;client_id is a URL: claude.ai/oauth/mcp-oauth-&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;client-metadata.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Your browser hits Clerk /oauth/authorize with PKCE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;challenge, scope and resource.&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; Clerk fetches Claude's CIMD document to learn who&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;the client is.&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; The document lists redirect_uris =&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;claude.ai/api/mcp/auth_callback.&lt;br&gt;&lt;b&gt;12.&lt;/b&gt; Clerk checks client admission, redirect_uri and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requested scopes against its settings.&lt;br&gt;&lt;b&gt;13.&lt;/b&gt; Clerk shows its sign-in page, then the consent&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;screen.&lt;br&gt;&lt;b&gt;14.&lt;/b&gt; You sign in and approve access.&lt;br&gt;&lt;b&gt;15.&lt;/b&gt; Clerk redirects your browser to the callback with&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;?code=...&lt;br&gt;&lt;b&gt;16.&lt;/b&gt; The browser delivers the code to claude.ai.&lt;br&gt;&lt;b&gt;17.&lt;/b&gt; claude.ai exchanges code + PKCE verifier for&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;tokens (public client, no secret).&lt;br&gt;&lt;b&gt;18.&lt;/b&gt; Clerk returns a JWT access token (+ refresh token&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;via offline_access).&lt;br&gt;&lt;b&gt;19.&lt;/b&gt; From now on every MCP request carries&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Authorization: Bearer &amp;lt;token&amp;gt;." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=6;" vertex="1" parent="v24"><mxGeometry x="0" y="40" width="430" height="710" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
